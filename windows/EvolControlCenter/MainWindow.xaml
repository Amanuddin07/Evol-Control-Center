<Window x:Class="EvolControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVOL CONTROL CENTER — Colorful Evol P15 2024"
        Height="780" Width="1220"
        Background="#090B0F" Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="EVOL CONTROL CENTER" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" />
        <TextBlock Text="{Binding AppVersion, StringFormat='Colorful Evol P15 2024 · v{0} · Local Bridge 127.0.0.1:17830'}" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Gaming" Command="{Binding SwitchModeCommand}" CommandParameter="gaming" Padding="18,8" Margin="0,0,8,0" Background="#F97316" Foreground="#090B0F" FontWeight="SemiBold" BorderThickness="0" />
        <Button Content="Work" Command="{Binding SwitchModeCommand}" CommandParameter="work" Padding="18,8" Margin="0,0,8,0" Background="#38BDF8" Foreground="#090B0F" FontWeight="SemiBold" BorderThickness="0" />
        <Button Content="Battery Saver" Command="{Binding SwitchModeCommand}" CommandParameter="battery" Padding="18,8" Background="#10B981" Foreground="#090B0F" FontWeight="SemiBold" BorderThickness="0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="#11151C" BorderBrush="#232A36" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
      <DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="780" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{Binding LoggingButtonText}" Command="{Binding ToggleLoggingCommand}" Padding="14,6" Margin="0,0,8,0" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" BorderThickness="1" />
          <Button Content="Reset Defaults" Command="{Binding ResetConfigCommand}" Padding="14,6" Background="#3F1D2B" Foreground="#FECDD3" BorderBrush="#881337" BorderThickness="1" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="2" Background="#090B0F" BorderBrush="#232A36" Margin="0,0,0,12">
      <TabItem Header="Dashboard &amp; Sensors">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#11151C" BorderBrush="#232A36" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="CPU Telemetry (LibreHardwareMonitor)" FontSize="13" Foreground="#94A3B8" />
              <TextBlock Text="{Binding Telemetry.CpuModel}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,6,0,10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Telemetry.CpuUtilizationPct, StringFormat='Load: {0:F1}%'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.CpuClockMhz, StringFormat='Clock: {0:F0} MHz', TargetNullValue='Clock: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.CpuTemperatureC, StringFormat='Package Temp: {0:F1} °C', TargetNullValue='Package Temp: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.CpuPackagePowerW, StringFormat='Package Power: {0:F1} W', TargetNullValue='Package Power: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.CpuVoltageV, StringFormat='Core Voltage: {0:F3} V', TargetNullValue='Core Voltage: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="#11151C" BorderBrush="#232A36" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="NVIDIA GPU (NVML)" FontSize="13" Foreground="#94A3B8" />
              <TextBlock Text="{Binding Telemetry.GpuModel, TargetNullValue='No Discrete GPU Detected'}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,6,0,10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Telemetry.GpuUtilizationPct, StringFormat='Load: {0:F1}%', TargetNullValue='Load: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.GpuTemperatureC, StringFormat='Core Temp: {0:F1} °C', TargetNullValue='Core Temp: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.GpuHotspotC, StringFormat='Hotspot: {0:F1} °C', TargetNullValue='Hotspot: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.GpuClockMhz, StringFormat='Clock: {0:F0} MHz', TargetNullValue='Clock: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.GpuPowerW, StringFormat='Board Power: {0:F1} W', TargetNullValue='Board Power: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="#11151C" BorderBrush="#232A36" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel>
              <TextBlock Text="Memory, Storage, Fans &amp; Battery" FontSize="13" Foreground="#94A3B8" />
              <TextBlock Text="{Binding Telemetry.RamUtilizationPct, StringFormat='RAM Used: {0:F1}%'}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,6,0,10" />
              <TextBlock Text="{Binding Telemetry.RamFrequencyMhz, StringFormat='RAM Speed: {0} MHz', TargetNullValue='RAM Speed: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.CpuFanRpm, StringFormat='CPU Fan: {0} RPM', TargetNullValue='CPU Fan: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.SsdTemperatureC, StringFormat='NVMe Temp: {0:F1} °C', TargetNullValue='NVMe Temp: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.BatteryPct, StringFormat='Battery: {0}%', TargetNullValue='Battery: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.DisplayResolution, StringFormat='Display: {0}', TargetNullValue='Display: Detecting...'}" Foreground="#CBD5E1" Margin="0,3" />
              <TextBlock Text="{Binding Telemetry.DisplayRefreshHz, StringFormat='Refresh Rate: {0} Hz', TargetNullValue='Refresh Rate: Unavailable'}" Foreground="#CBD5E1" Margin="0,3" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Hardware Compatibility Report">
        <DataGrid ItemsSource="{Binding CompatibilityChecks}" AutoGenerateColumns="True" IsReadOnly="True" Margin="12" Background="#11151C" Foreground="#F1F5F9" RowBackground="#11151C" AlternatingRowBackground="#161B24" />
      </TabItem>

      <TabItem Header="Diagnostics &amp; Updates">
        <StackPanel Margin="12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Scan Windows EventLog" Command="{Binding ScanDiagnosticsCommand}" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="Scan Winget Updates" Command="{Binding ScanUpdatesCommand}" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="Switch Display 144Hz" Command="{Binding SetRefreshRateCommand}" CommandParameter="144" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="Switch Display 60Hz" Command="{Binding SetRefreshRateCommand}" CommandParameter="60" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="Reboot to UEFI Firmware" Command="{Binding RebootUefiCommand}" Padding="14,7" Background="#3F1D2B" Foreground="#FECDD3" />
          </StackPanel>
          <TextBlock Text="{Binding StabilityScore, StringFormat='Windows Stability Score: {0} / 100'}" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />
          <DataGrid ItemsSource="{Binding SystemEvents}" AutoGenerateColumns="True" IsReadOnly="True" Height="180" Margin="0,0,0,12" Background="#11151C" Foreground="#F1F5F9" RowBackground="#11151C" AlternatingRowBackground="#161B24" />
          <DataGrid ItemsSource="{Binding AvailableUpdates}" AutoGenerateColumns="True" IsReadOnly="True" Height="160" Background="#11151C" Foreground="#F1F5F9" RowBackground="#11151C" AlternatingRowBackground="#161B24" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Settings &amp; Startup">
        <StackPanel Margin="16">
          <CheckBox Content="Launch EVOL CONTROL CENTER automatically with Windows (minimized to tray)" IsChecked="{Binding LaunchWithWindows}" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,12" />
          <TextBlock Text="{Binding Telemetry.BiosVendor, StringFormat='BIOS Vendor: {0}', TargetNullValue='BIOS Vendor: WMI Unavailable'}" Foreground="#94A3B8" Margin="0,3" />
          <TextBlock Text="{Binding Telemetry.BiosVersion, StringFormat='BIOS Version: {0}', TargetNullValue='BIOS Version: WMI Unavailable'}" Foreground="#94A3B8" Margin="0,3" />
          <TextBlock Text="{Binding Telemetry.OsVersion, StringFormat='Operating System: {0}'}" Foreground="#94A3B8" Margin="0,3" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="3">
      <TextBlock Text="{Binding FanCapabilitySummary}" Foreground="#64748B" FontSize="11" />
      <TextBlock Text="{Binding KeyboardCapabilitySummary}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</Window>
